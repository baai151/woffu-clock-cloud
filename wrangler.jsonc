{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "woffu-clock-cloud",
  "main": "src/index-v11.js",
  "compatibility_date": "2026-08-26",
  "keep_vars": true,
  // The inline client uses function.toString(); avoid external name helpers.
  "keep_names": false,
  "secrets": {
    "required": [
      "ADMIN_PASSWORD",
      "WOFFU_EMAIL",
      "WOFFU_PASSWORD"
    ]
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB"
    }
  ]
}
